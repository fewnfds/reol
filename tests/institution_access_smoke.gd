extends "res://tests/agency_food_smoke.gd"
const Stock = preload("res://scripts/sim/kernel/stock_rules.gd")
const Roles = preload("res://scripts/sim/kernel/institution_defs.gd")

func workshop(w: RefCounted, org: int, definition: String, cell: Vector2i) -> int:
	var id: int = w.facilities.create_completed(w, definition, w.Terrain.index(cell))
	w.objects.records[id].organization = org
	return id

func scoped_work_and_revoke() -> void:
	var w: RefCounted = peaceful()
	var org: int = w.institutions.create("青禾宗")
	for actor: int in [3, 4]: w.institutions.admit(w, org, actor, []); move_actor(w, actor, Vector2(125.5, 123.5))
	var chest: int = workshop(w, org, "wood_chest", Vector2i(123, 122))
	var stove: int = workshop(w, org, "cook_stove", Vector2i(125, 122))
	var other: int = workshop(w, org, "cook_stove", Vector2i(129, 122))
	var wall: int = workshop(w, org, "wood_wall", Vector2i(132, 122))
	w.flush_topology()
	for item: String in ["grain", "water", "potion"]: w.objects.add(chest, item, 4, Stock.right(0, org))
	var a: int = w.institutions.appoint(w, org, 4, "kitchen_craft", [chest, stove])
	check(a > 0 and w.institutions.appoint(w, org, 3, "kitchen_craft", [chest, stove]) > 0, "Scoped appointments refused")
	check(w.execute_operation(4, {"kind": "demolish", "target": wall}) == "not_authorized", "Kitchen appointment authorized dismantling other property")
	check(w.begin_transfer(4, {"kind": "take", "target": chest, "item": "potion", "amount": 1, "purpose": "cook"}) == "not_authorized", "Empty-item query bypassed the real selected-item scope")
	check(w.institutions.move_goods(w, 4, chest, "potion", 1, "take", {"purpose": "cook"}, 0).reason == "not_authorized", "Direct transfer bypassed item scope")
	for item: String in ["grain", "water"]:
		check(w.institutions.move_goods(w, 4, chest, item, 2 if item == "grain" else 1, "take", {"purpose": "cook"}, 0).status == "completed", "Scoped lawful material issue failed")
	check(not w.institutions.input_right(w, 4, {"grain": 2, "water": 1}, "cook", org).is_empty(), "Valid scoped materials became invisible in custody")
	check(w.begin_interaction(4, {"kind": "cook", "target": other}) == "not_authorized", "A purpose at one stove authorized another stove")
	check(w.begin_interaction(4, {"kind": "cook", "target": stove}) == "accepted", "Scoped cook failed to use authorized stove")
	w.settle_action(4, 0)
	advance(w, 1000)
	check(w.objects.records[stove].has("process") and w.objects.amount(4, "grain") == 0, "Scoped work never actually put ingredients in the pot")
	check(w.institutions.revoke(w, a) and not w.actions.has(4) and not w.reservations.has(stove), "Revoking a role left an unauthorized running action")
	check(w.objects.records[stove].process.remaining_ms < w.Operations.OPERATIONS.cook.recipe.work_ms and not w.objects.records[stove].work_stock.is_empty(), "Revocation lost actual labor or in-process materials")
	check(w.begin_interaction(3, {"kind": "cook", "target": stove}) == "accepted", "Authorized replacement could not continue original pot")
	advance(w, w.elapsed_ms + 7000)
	check(w.objects.amount(stove, "meal") > 0 and not w.objects.records[stove].has("process"), "Replacement did not produce original attributed meals")
	check(Persistence.candidate(Persistence.capture(w), 0) != null, "Scoped work and revoked history failed restoration")

func service_arrangements() -> void:
	var w: RefCounted = peaceful()
	var org: int = w.institutions.create("青禾宗")
	for actor: int in [3, 4]: w.institutions.admit(w, org, actor, ["rest"])
	var bed: int = workshop(w, org, "wood_bed", Vector2i(125, 120))
	var public_bed: int = workshop(w, org, "wood_bed", Vector2i(127, 120))
	w.flush_topology()
	check(w.institutions.arrange_service(w, bed, "rest", [4]), "Bed assignment refused")
	check(not w.reservations.has(bed), "Social bed assignment preoccupied physical work position")
	check(w.begin_interaction(3, {"kind": "rest", "target": bed}) == "not_authorized", "Broad rest permission overrode assigned bed")
	check(w.begin_interaction(3, {"kind": "rest", "target": public_bed}) == "accepted", "Unassigned public bed lost ordinary rest permission")
	w.release(3)
	move_actor(w, 4, Vector2(125.5, 120.5))
	check(w.begin_interaction(4, {"kind": "rest", "target": bed}) == "accepted", "Assigned member could not use their bed")
	w.settle_action(4, 0)
	check(w.institutions.arrange_service(w, bed, "rest", [3]) and not w.actions.has(4) and not w.reservations.has(bed), "Changed service arrangements did not release unauthorized sleeper")
	w.knowledge.refresh(w, 4, bed, 0)
	var clue: Dictionary = w.knowledge.view(4, bed, 0)
	check(clue.get("services") == {"rest": true} and not str(clue.get("services")).contains("actors"), "Public observation exposed assigned people")
	check(Persistence.candidate(Persistence.capture(w), 0) != null, "Service restrictions or private grants failed candidate restore")
	check(w.remove_static(bed) and not w.institutions.services.has(bed), "Removed bed left service authority")
	check(Persistence.candidate(Persistence.capture(w), 0) != null, "Service target deletion corrupted restoration")

func revoked_return_is_narrow() -> void:
	var w: RefCounted = peaceful()
	var org: int = w.institutions.create("青禾宗")
	w.institutions.admit(w, org, 4, [])
	var chest: int = workshop(w, org, "wood_chest", Vector2i(125, 120))
	w.objects.add(chest, "grain", 1, Stock.right(0, org))
	var a: int = w.institutions.appoint(w, org, 4, "kitchen_craft", [chest])
	w.institutions.move_goods(w, 4, chest, "grain", 1, "take", {"purpose": "cook"}, 0)
	w.institutions.revoke(w, a)
	w.objects.add(4, "potion", 1, Stock.right(4))
	check(w.begin_transfer(4, {"kind": "put", "target": chest, "item": "potion", "amount": 1}) == "not_authorized", "A grain return authorized unrelated private goods")
	check(w.institutions.move_goods(w, 4, chest, "grain", 1, "put", {"donate": true}, 0).reason == "not_authorized", "Revoked custody became donation authority")
	check(w.institutions.move_goods(w, 4, chest, "grain", 1, "put", {}, 0).status == "completed" and w.institutions.returns(w, 4).is_empty(), "Revoked material could not be returned without new authority")
	check(w.institutions.appoint(w, org, 4, "kitchen_craft", ["bad"]) == 0 and w.institutions.appoint(w, org, 4, "kitchen_craft", []) == 0, "Bad role scope was partially applied")
	var state: Dictionary = Persistence.capture(w)
	state.domains.institutions.catalog_signature = "bad"
	check(Persistence.candidate(state, 0) == null, "Changed authority definitions were silently restored")
	check(Persistence.candidate(Persistence.capture(w), 0) != null, "Bad role candidate damaged live world")

func autonomous_scoped_cooking() -> void:
	var w: RefCounted = peaceful()
	var org: int = w.institutions.create("青禾宗")
	w.institutions.admit(w, org, 4, [])
	move_actor(w, 4, Vector2(123.5, 120.5))
	var chest: int = workshop(w, org, "wood_chest", Vector2i(125, 120))
	var stove: int = workshop(w, org, "cook_stove", Vector2i(127, 122))
	w.institutions.appoint(w, org, 4, "kitchen_craft", [chest, stove])
	w.objects.add(chest, "grain", 2, Stock.right(0, org)); w.objects.add(chest, "water", 1, Stock.right(0, org))
	w.flush_topology(); resident(w, 4, [chest, stove])
	w.pages[0].hunger[3] = 10000; w.pages[0].energy[3] = 10000
	var goal: int = w.livelihood.add_goal(w, 4, "operation", {"operation": "cook", "target": stove})
	w.decisions.prepare(w, 0)
	advance(w, 16000)
	check(w.objects.amount(stove, "meal") == 3 and w.objects.amount(chest, "grain") == 0 and w.livelihood.records[4].goals[goal].state == "completed", "Scoped NPC did not actually acquire inputs, keep and cook them through the normal planner: " + str({"meal": w.objects.amount(stove, "meal"), "grain": w.objects.amount(chest, "grain"), "purpose": w.livelihood.describe(4)}))
	check(Persistence.candidate(Persistence.capture(w), 0) != null, "Autonomous scoped role lost recovery")

func reviewed_boundaries() -> void:
	var w: RefCounted = peaceful()
	var org: int = w.institutions.create("青禾宗")
	for actor: int in [3, 4]: w.institutions.admit(w, org, actor, [])
	var chest: int = workshop(w, org, "wood_chest", Vector2i(125, 120))
	var bed: int = workshop(w, org, "wood_bed", Vector2i(127, 120))
	var plant: int = w.nature.create(w, "perennial_herb", w.Terrain.index(Vector2i(129, 120)), false, true)
	w.objects.records[plant].organization = org
	w.objects.records[plant].stage = w.nature.Stage.MATURE
	w.objects.add(plant, "herb", 1, Stock.right(0, org))
	w.institutions.appoint(w, org, 4, "kitchen_craft", [chest])
	w.institutions.appoint(w, org, 3, "plant_care", [plant])
	w.institutions.arrange_service(w, bed, "rest", [3])
	w.objects.add(chest, "potion", 1, Stock.right(4))
	var view: Dictionary = w.operation_actor(4)
	check(Stock.known_quantity(view, w.operation_target(chest), "potion", "take", 0) == 0, "Private deposit ignored the container's item scope")
	var planner: RefCounted = preload("res://scripts/sim/kernel/agency_planner.gd").new()
	view["speed"] = 2.0
	planner.configure(view, w.operation_target(4), {chest: w.operation_target(chest)}, {}, Vector2(123.5, 120.5), 0, {"work": 0, "cursor": 0}, {})
	check(planner._acquire("potion", 1, 0, "", []).is_empty(), "Planner advertised a forbidden private deposit")
	w.objects.add(4, "potion", 1, Stock.right(4))
	check(planner._deposit("potion", 1, org, chest, []).is_empty(), "Planner advertised a forbidden private placement")
	for operation: String in ["sow", "gather", "cut", "uproot"]:
		check(w.OperationQuery.access_reason(w.Operations.OPERATIONS[operation], w.operation_actor(3), w.operation_target(plant)) == "not_authorized", "Water-only care authorized harvesting or replacing a plant: " + operation)
	var state: Dictionary = Persistence.capture(w)
	for broken: Variant in [null, "bad", [], {}]:
		var bad: Dictionary = state.duplicate(true)
		bad.domains.institutions.memberships[org] = broken
		check(Persistence.candidate(bad, 0) == null, "Malformed nested membership did not reject atomically")
	var bad_service: Dictionary = state.duplicate(true)
	bad_service.domains.institutions.services[bed].rest.organization = float(org)
	check(Persistence.candidate(bad_service, 0) == null, "Floating-point service identity bypassed cold validation")
	var bad_target: Dictionary = state.duplicate(true)
	bad_target.domains.objects.records[bed].organization = org + 100
	check(Persistence.candidate(bad_target, 0) == null, "Unknown service organization caused an unsafe lookup")
	w.kill(4)
	check(w.institutions.move_goods(w, 4, chest, "potion", 1, "take", {}, 0).status == "refused" and w.institutions.acquire_yield(w, 4, plant, "herb", 1, 0) == 0 and not w.institutions.consume_at(w, 4, plant, "herb", 1, "eat"), "Dead actor used a direct material consumer")
	check(w.nature.tend_check(w, 4, plant) == "dead" and w.nature.plant_site(w, 4, "annual_grass", 0).reason == "dead", "Dead actor entered a direct cultivation consumer")
	check(w.remove_static(bed) and w.remove_actor(3), "History fixture did not remove the actual subjects")
	check(Persistence.candidate(Persistence.capture(w), 0) != null, "Dead appointment holder or removed service target corrupted legitimate history")

func scoped_completion_removes_target() -> void:
	var w: RefCounted = peaceful()
	var org: int = w.institutions.create("青禾宗")
	for actor: int in [3, 4]: w.institutions.admit(w, org, actor, [])
	var plant: int = w.nature.create(w, "perennial_herb", w.Terrain.index(Vector2i(125, 120)), false, true)
	w.objects.records[plant].organization = org
	var appointment: int = w.institutions.appoint(w, org, 4, "provisioning", [plant])
	move_actor(w, 4, Vector2(125.5, 120.5))
	check(w.begin_interaction(4, {"kind": "uproot", "target": plant}) == "accepted", "Scoped uproot never began")
	w.settle_action(4, 0)
	advance(w, 1800)
	var result: Dictionary = w.activity_results.view(4).back()
	check(result.status == "completed" and result.operation == "uproot" and not w.objects.records.has(plant), "Removing the final scope target rewrote successful work as permission denial: " + str(result))
	check(not w.institutions.appointments[appointment].active and Persistence.candidate(Persistence.capture(w), 0) != null, "Successful scoped removal left invalid active scope")

func _run() -> void:
	check(Roles.ERRORS.is_empty(), "Invalid institution definitions: " + str(Roles.ERRORS))
	scoped_work_and_revoke()
	service_arrangements()
	revoked_return_is_narrow()
	autonomous_scoped_cooking()
	reviewed_boundaries()
	scoped_completion_removes_target()
	print("INSTITUTION_ACCESS_SMOKE errors=", errors)
	quit(0 if errors == 0 else 1)
