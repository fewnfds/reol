# Godot 4+ specific ignores
.godot/
/android/

# Build / export output
/build/
/exports/
*.exe
*.pck
*.zip

# Local tooling
.local/advisor/
.venv/
__pycache__/
*.pyc
logs/
artifacts/
*.log
*.tmp

# OS / editor noise
.DS_Store
Thumbs.db
*.swp

# Secrets
.env
.env.*

# Raw external references stay local until provenance and privacy are reviewed.
/art_inbox/*
!/art_inbox/README.md
!/art_inbox/.gdignore
!/art_inbox/character_generation/
/art_inbox/character_generation/*
!/art_inbox/character_generation/README.md
