interval_ms = 1750

[sub_resource type="Resource" id="Rule1"]
script = ExtResource("2")
action = "approach"

[resource]
script = ExtResource("1")
id = "heavy"
title = "重击与破绽"
reaction_ms = 360
think_ms = 100
rules = Array[ExtResource("2")]([SubResource("Rule0"),SubResource("Rule1")])
