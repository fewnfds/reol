[gd_resource type="Resource" script_class="CombatAbilityDef" load_steps=10 format=3]
[ext_resource type="Script" path="res://scripts/sim/definitions/combat/ability_def.gd" id="1"]
[ext_resource type="Script" path="res://scripts/sim/definitions/combat/delivery_def.gd" id="2"]
[ext_resource type="Script" path="res://scripts/sim/definitions/actions/effect_def.gd" id="3"]

[ext_resource type="Script" path="res://scripts/sim/definitions/actions/effect_bundle_def.gd" id="bundle_type"]

[sub_resource type="Resource" id="Delivery"]
script = ExtResource("2")
kind = "area"
target = "self"
radius = 2.8
delay_ms = 100
target_filter = "hostile"

[sub_resource type="Resource" id="Effect0"]
script = ExtResource("3")
kind = "damage"
magnitude = 0.8

[sub_resource type="Resource" id="Effect1"]
script = ExtResource("3")
kind = "control"
duration_ms = 120
push = 0.2
punish_ms = 0

[sub_resource type="Resource" id="Effect2"]
script = ExtResource("3")
kind = "slow"
status_id = "chill"
magnitude = 0.45
duration_ms = 2200
period_ms = 0

[sub_resource type="Resource" id="Bundle"]
script = ExtResource("bundle_type")
effects = Array[ExtResource("3")]([SubResource("Effect0"), SubResource("Effect1"), SubResource("Effect2")])

[resource]
script = ExtResource("1")
