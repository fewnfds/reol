[gd_resource type="Resource" script_class="CombatLoadoutDef" load_steps=7 format=3]
[ext_resource type="Script" path="res://scripts/sim/definitions/combat/loadout_def.gd" id="loadout"]
[ext_resource type="Script" path="res://scripts/sim/definitions/actions/pool_def.gd" id="pool_type"]
[ext_resource type="Resource" path="res://data/definitions/actions/mana.tres" id="pool_mana"]
[ext_resource type="Script" path="res://scripts/sim/definitions/actions/reaction_def.gd" id="reaction_type"]
[ext_resource type="Resource" path="res://data/definitions/actions/guard_counter.tres" id="r_guard_counter"]
[ext_resource type="Resource" path="res://data/definitions/actions/shield_break.tres" id="r_shield_break"]
[resource]
script = ExtResource("loadout")
id = "guardian"
title = "守势剑"
primary = "slash_1"
skill = "guard_stance"
description = "左键三连；右键定向格挡与短盾。盾不等于无敌，格挡时机与朝向决定收益。"
pools = Array[ExtResource("pool_type")]([ExtResource("pool_mana")])
reactions = Array[ExtResource("reaction_type")]([ExtResource("r_guard_counter"), ExtResource("r_shield_break")])
