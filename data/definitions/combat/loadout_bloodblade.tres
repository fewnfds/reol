[gd_resource type="Resource" script_class="CombatLoadoutDef" load_steps=11 format=3]
[ext_resource type="Script" path="res://scripts/sim/definitions/combat/loadout_def.gd" id="loadout"]
[ext_resource type="Script" path="res://scripts/sim/definitions/actions/pool_def.gd" id="pool_type"]
[ext_resource type="Resource" path="res://data/definitions/actions/rage.tres" id="p_rage"]
[ext_resource type="Resource" path="res://data/definitions/actions/mana.tres" id="p_mana"]
[ext_resource type="Script" path="res://scripts/sim/definitions/actions/reaction_def.gd" id="reaction_type"]
[ext_resource type="Resource" path="res://data/definitions/actions/blood_feed.tres" id="r_blood_feed"]
[ext_resource type="Resource" path="res://data/definitions/actions/gather_mana.tres" id="r_gather_mana"]
[ext_resource type="Resource" path="res://data/definitions/actions/blood_resolve.tres" id="r_resolve"]
[ext_resource type="Resource" path="res://data/definitions/actions/guard_counter.tres" id="r_counter"]
[ext_resource type="Resource" path="res://data/definitions/actions/shield_break.tres" id="r_break"]
[resource]
script = ExtResource("loadout")
id = "bloodblade"
title = "血刃"
primary = "slash_1"
skill = "guard_stance"
skill2 = "blood_burst"
skill3 = "renewal"
description = "左键三连以实际损血吸血、获怒；右键守势反击，E耗21怒终结，C耗蓝回元。正面格挡和命中取消决定进攻节奏。"
pools = Array[ExtResource("pool_type")]([ExtResource("p_rage"), ExtResource("p_mana")])
reactions = Array[ExtResource("reaction_type")]([ExtResource("r_blood_feed"), ExtResource("r_gather_mana"), ExtResource("r_resolve"), ExtResource("r_counter"), ExtResource("r_break")])
