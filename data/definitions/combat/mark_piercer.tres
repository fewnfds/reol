[gd_resource type="Resource" script_class="CombatAbilityDef" load_steps=12 format=3]
[ext_resource type="Script" path="res://scripts/sim/definitions/combat/ability_def.gd" id="ability"]
[ext_resource type="Script" path="res://scripts/sim/definitions/combat/delivery_def.gd" id="delivery"]
[ext_resource type="Script" path="res://scripts/sim/definitions/actions/effect_def.gd" id="effect"]
[ext_resource type="Script" path="res://scripts/sim/definitions/actions/effect_bundle_def.gd" id="bundle"]
[ext_resource type="Resource" path="res://data/definitions/actions/sequence_mark.tres" id="status"]
[ext_resource type="Script" path="res://scripts/sim/definitions/actions/reaction_def.gd" id="rule"]
[ext_resource type="Resource" path="res://data/definitions/actions/owned_mark_burst.tres" id="burst"]

[sub_resource type="Resource" id="Delivery"]
script = ExtResource("delivery")
kind = "projectile"
speed = 20.0
pierce = 3
target_filter = "hostile"

[sub_resource type="Resource" id="Effect0"]
script = ExtResource("effect")
kind = "damage"
magnitude = 0.35

[sub_resource type="Resource" id="Effect1"]
script = ExtResource("effect")
kind = "status"
status = ExtResource("status")

[sub_resource type="Resource" id="Bundle"]
script = ExtResource("bundle")
effects = Array[ExtResource("effect")]([SubResource("Effect0"), SubResource("Effect1")])

[resource]
script = ExtResource("ability")
id = "mark_piercer"
title = "序印针"
windup = 100
active = 1
recovery = 230
stat = "ranged"
description = "同一次穿透针的第二次命中引爆本次留下的印记；状态由受信脚本宿主保存。"
delivery = SubResource("Delivery")
bundle = SubResource("Bundle")
reactions = Array[ExtResource("rule")]([ExtResource("burst")])
