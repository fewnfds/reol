[gd_resource type="Resource" script_class="CombatAbilityDef" load_steps=10 format=3]
[ext_resource type="Script" path="res://scripts/sim/definitions/combat/ability_def.gd" id="ability"]
[ext_resource type="Script" path="res://scripts/sim/definitions/combat/delivery_def.gd" id="delivery"]
[ext_resource type="Script" path="res://scripts/sim/definitions/actions/effect_def.gd" id="effect"]
[ext_resource type="Script" path="res://scripts/sim/definitions/actions/effect_bundle_def.gd" id="bundle"]
[ext_resource type="Script" path="res://scripts/sim/definitions/actions/reaction_def.gd" id="reaction_type"]
[ext_resource type="Resource" path="res://data/definitions/actions/star_contact.tres" id="r_star_contact"]

[sub_resource type="Resource" id="Delivery"]
script = ExtResource("delivery")
kind = "projectile"
speed = 20.0
lifetime_ms = 1000
radius = 0.13
target_filter = "hostile"

[sub_resource type="Resource" id="Effect0"]
script = ExtResource("effect")
kind = "damage"
magnitude = 0.8

[sub_resource type="Resource" id="Bundle"]
script = ExtResource("bundle")
effects = Array[ExtResource("effect")]([SubResource("Effect0")])

[resource]
script = ExtResource("ability")
id = "star_arrow"
title = "裂星箭"
windup = 100
active = 1
recovery = 140
stat = "ranged"
repeat_held = true
move = 1.0
free_move = 1.0
description = "命中后向前分裂为3枚独立载荷碎片；已命中的目标排除。"
delivery = SubResource("Delivery")
bundle = SubResource("Bundle")
reactions = Array[ExtResource("reaction_type")]([ExtResource("r_star_contact")])
