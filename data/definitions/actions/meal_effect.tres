[ext_resource type="Script" path="res://scripts/sim/definitions/actions/effect_def.gd" id="effect"]
[ext_resource type="Resource" path="res://data/definitions/actions/meal_fortitude.tres" id="fortitude"]
[sub_resource type="Resource" id="Buff"]
script = ExtResource("effect")
