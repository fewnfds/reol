[resource]
script = ExtResource("library")
goals = Array[ExtResource("goal")]([SubResource("Fed"), SubResource("Rested"), SubResource("Recovery"), SubResource("Development"), SubResource("Delivery"), SubResource("Operation"), SubResource("Custody"), SubResource("Responsibility"), SubResource("dutyGoal"), SubResource("serviceGoal"), SubResource("reportingGoal"), SubResource("responsesGoal"), SubResource("instructionGoal")])
approaches = Array[ExtResource("approach")]([SubResource("Eat"), SubResource("PrepareFood"), SubResource("Rest"), SubResource("Develop"), SubResource("Deliver"), SubResource("Perform"), SubResource("Return"), SubResource("ResponsibilityApproach"), SubResource("dutyApproach"), SubResource("serviceApproach"), SubResource("reportingApproach"), SubResource("respondApproach"), SubResource("seekHelpApproach"), SubResource("instructionApproach")])
